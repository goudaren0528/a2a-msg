{
  "name": "team-mailbox",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "bin": { "a2a-msg": "bin/a2a-msg.mjs" },
  "files": ["bin/", "scripts/", "src/", "docs/", "!docs/delivery/*/evidence/", "!docs/delivery/*/shots/", "README.md", "access.example.json", ".env.example", "compose.yaml", "Dockerfile", "package-lock.json"],
  "type": "module",
  "description": "Lightweight LAN team mailbox with MCP stdio bridge",
  "scripts": {
    "start": "node src/server.js",
    "mcp": "node src/mcp.js",
    "admin": "node src/admin.js",
    "doctor": "node src/doctor.js",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ipaddr.js": "2.2.0",
    "zod": "^3.25.76"
  }
}
